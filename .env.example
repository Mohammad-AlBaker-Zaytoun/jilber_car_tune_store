# Copy this to .env (Prisma reads .env) / .env.local and fill in values

# ---------------------------------------------------------------------------
# Required: MSSQL connection (Prisma sqlserver connector)
# ---------------------------------------------------------------------------
# Local SQL Server via Docker:
#   docker run -e "ACCEPT_EULA=Y" -e "MSSQL_SA_PASSWORD=Your_strong_Pass123" \
#     -p 1433:1433 -d --name jilber-mssql mcr.microsoft.com/mssql/server:2022-latest
#   docker exec -it jilber-mssql /opt/mssql-tools18/bin/sqlcmd -S localhost \
#     -U sa -P 'Your_strong_Pass123' -C -Q "CREATE DATABASE jilber"
#
# encrypt=true + trustServerCertificate=true are required for the container's
# self-signed cert. For Azure SQL drop trustServerCertificate, keep encrypt=true.
DATABASE_URL="sqlserver://localhost:1433;database=jilber;user=sa;password=Your_strong_Pass123;encrypt=true;trustServerCertificate=true"

# Required: Secret key used to sign session JWTs (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Also signs the "pay for this order" links emailed when the payment gateway is
# unavailable (lib/payments/pay-token.ts). Rotating this invalidates any
# outstanding pay links as well as all sessions — rotate BEFORE launch, while no
# real links exist.
AUTH_SECRET=your-secret-key-here-minimum-32-chars

# SEO: Production URL used for canonical URLs, Open Graph, and sitemap
# Must NOT have a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Optional: Email (Resend). If RESEND_API_KEY is unset, emails are no-ops.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender. Defaults to Resend's test sender if unset.
EMAIL_FROM="JILBER Performance <orders@yourdomain.com>"
# Where new-order / new-quote admin alerts are sent.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Reverse proxy: how many proxies sit between the internet and this process.
#
# 1 = the nginx in deploy/nginx.conf (the normal VPS setup). 0 = the app is
# exposed directly. lib/rate-limit.ts reads the client IP as the Nth entry from
# the RIGHT of X-Forwarded-For; setting this too HIGH lets clients forge their IP
# and bypass every rate limit, so only raise it if you really have that many
# trusted proxies (e.g. 2 for Cloudflare + nginx).
# ---------------------------------------------------------------------------
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Optional: Whish Money card payments. If unset, the "Card" checkout option
# returns 503 and customers use shop/bank instead. websiteUrl reuses
# NEXT_PUBLIC_SITE_URL.
#
# IMPORTANT: whish-pay selects sandbox vs production from NODE_ENV alone.
# NODE_ENV=production -> real charges. Anything else -> sandbox, where checkout
# LOOKS successful but no money moves. The app refuses to boot with credentials
# set and NODE_ENV != production unless WHISH_ALLOW_SANDBOX=1 is set.
# ---------------------------------------------------------------------------
WHISH_CHANNEL=
WHISH_SECRET=
# Set to 1 ONLY when deliberately testing against the Whish sandbox.
WHISH_ALLOW_SANDBOX=

# ---------------------------------------------------------------------------
# Optional: Product image uploads (VPS). When unset, files go to
# public/products/uploads (fine for local dev, but wiped on redeploy).
# In production point these at a PERSISTENT dir served by the reverse proxy.
# ---------------------------------------------------------------------------
# Absolute filesystem path, e.g. /var/lib/jilber/uploads
UPLOAD_DIR=
# URL prefix the reverse proxy serves UPLOAD_DIR from (no trailing slash)
UPLOAD_PUBLIC_PATH=/products/uploads

# ---------------------------------------------------------------------------
# One-time admin bootstrap (npm run db:seed:admin). Creates/promotes one admin.
# Unset these again after running.
#
# This is the ONLY supported way to create an admin on a real deployment.
# `npm run db:seed` is a destructive dev-only importer and refuses to run against
# production (see prisma/seed.ts).
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME="Site Admin"

# ---------------------------------------------------------------------------
# Backups — deploy/backup.sh and deploy/restore-drill.sh.
# DB_USER / DB_PASS are the sqlcmd credentials (the BACKUP DATABASE statement
# cannot reuse the Prisma DATABASE_URL string).
# ---------------------------------------------------------------------------
DB_NAME=jilber
DB_HOST=localhost
DB_USER=
DB_PASS=
BACKUP_DIR=/var/backups/jilber
# Directory the SQL Server process itself can write to.
MSSQL_BACKUP_DIR=/var/opt/mssql/backups
RETENTION_DAYS=14
# rsync/scp destination. Unset means backups only exist on the box they protect.
OFFSITE_DEST=

# ---------------------------------------------------------------------------
# Rate limiting. Orders accepted per minute from one IP address; the default of
# 8 applies when this is unset or not a positive integer. Raise it only if a
# legitimate shared address (a corporate NAT, a kiosk) is being throttled --
# lowering it is safe, raising it widens the window for automated order spam.
# The Playwright suite sets this high for its own run; see playwright.config.ts.
# ---------------------------------------------------------------------------
ORDER_RATE_LIMIT_PER_MINUTE=8
resend_api_key=key
telegrambot_apikey=key