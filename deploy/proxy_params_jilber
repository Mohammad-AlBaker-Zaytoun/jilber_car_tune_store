# Shared proxy headers for the JILBER store.
#   sudo cp deploy/proxy_params_jilber /etc/nginx/proxy_params_jilber
#
# THE CRITICAL LINE IS X-Forwarded-For.
#
# lib/rate-limit.ts resolves the client IP as the Nth entry from the RIGHT of
# X-Forwarded-For, where N = TRUSTED_PROXY_COUNT (1 here). Using `$remote_addr`
# rather than `$proxy_add_x_forwarded_for` means we OVERWRITE whatever the client
# sent instead of appending to it, so a forged header cannot survive at all.
#
# Both settings are safe together: with $remote_addr the header has one entry and
# "1st from the right" is that entry. If you ever switch to
# $proxy_add_x_forwarded_for, the app still reads the value nginx appended.

proxy_http_version 1.1;

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;

# WebSocket / HMR upgrade passthrough.
proxy_set_header Upgrade    $http_upgrade;
proxy_set_header Connection $connection_upgrade;

proxy_connect_timeout 10s;
proxy_send_timeout    60s;
proxy_read_timeout    60s;

proxy_buffering on;
proxy_redirect off;
