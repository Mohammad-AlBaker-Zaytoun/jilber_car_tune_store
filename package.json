{
  "name": "jilber_car_tune_store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:studio": "prisma studio",
    "reconcile:payments": "tsx scripts/reconcile-payments.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:demo": "npm run build:e2e && playwright test --headed --project=storefront --project=gateway-outage",
    "test:e2e:ui": "npm run build:e2e && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:only": "playwright test",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.24"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "whish-pay": "^1.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
